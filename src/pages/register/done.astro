---
// Step 5 of the Register flow: where the external registration form sends
// people after they submit (set the form's "redirect on completion" to
// /register/done/). It shows nothing about the entrant and asks for nothing.
// Hidden from search engines, like any page that only makes sense after a submit.
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../site';

const next = [
  { label: 'Deadline', value: '[date]' },
  { label: 'Judging', value: '[dates]' },
  { label: 'Results', value: '[date]' },
];
---

<Base title="Your essay is in" description={`Thank you for entering the ${SITE_NAME} essay competition.`} noindex>
  <main id="main" class="done">
    <span class="rings done__rings" aria-hidden="true"></span>
    <div class="done__inner">
      <p class="done__count">Step 5 of 5</p>
      <div class="done__prog" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span class="is-last"></span>
      </div>
      <h1 class="done__title">Your essay is in.</h1>
      <p class="t-body-lg">It's marked as pending until we confirm your payment. We'll email you within 48 hours to confirm you're registered.</p>

      <section class="next" aria-labelledby="next-title">
        <h2 id="next-title" class="next__title">What happens next</h2>
        {/* DATES: fill in the judging dates and the results date (see PLACEHOLDERS.md). */}
        <dl class="next__list">
          {next.map((n) => (
            <div class="next__row"><dt>{n.label}</dt><dd>{n.value}</dd></div>
          ))}
        </dl>
      </section>

      <a class="btn btn--cream done__back" href="/competition/">Back to the competition</a>
    </div>
  </main>
</Base>

<style>
  .done { position: relative; min-height: 100svh; background: var(--c-plum); color: var(--c-cream); overflow: hidden; display: flex; flex-direction: column; }
  .done :global(:focus-visible) { outline-color: var(--c-cream); }
  .done__rings { --ring: var(--c-pink); --s: 340px; width: var(--s); height: var(--s); right: -150px; top: -150px; opacity: 0.8; }
  .done__inner { position: relative; display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-1) var(--gutter) var(--space-3); flex: 1; max-width: 760px; width: 100%; }
  .done__count { align-self: flex-end; min-height: 56px; display: flex; align-items: center; font-weight: 600; }
  .done__prog { display: flex; gap: 6px; }
  .done__prog span { flex: 1; height: 8px; border-radius: 4px; background: var(--c-peach); }
  .done__prog .is-last { background: var(--c-coral); }
  .done__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-display); line-height: 1; margin-top: var(--space-6); }

  .next { margin-top: var(--space-4); }
  .next__title { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-heading-sm); line-height: 1.1; margin-bottom: 12px; }
  .next__list { margin: 0; }
  .next__row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; border-top: 1.5px solid var(--c-plum-rule); padding: 12px 0; }
  .next__row:last-child { border-bottom: 1.5px solid var(--c-plum-rule); }
  .next__row dt { font-weight: 600; color: var(--c-peach); }
  .next__row dd { margin: 0; }
  .done__back { align-self: stretch; justify-content: center; min-height: 56px; margin-top: auto; font-size: var(--fs-body-lg); }
  .done__inner > .done__back { margin-top: var(--space-4); }

  @media (min-width: 960px) {
    .done__rings { --ring-gap: 11px; --s: 520px; right: -200px; top: -200px; }
    .done__inner { padding: var(--space-4) var(--gutter) var(--space-6); }
    .done__title { margin-top: var(--space-12); }
    .done__back { align-self: flex-start; min-width: 280px; }
  }
</style>
