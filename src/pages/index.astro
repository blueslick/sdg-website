---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import EditionCover from '../components/EditionCover.astro';
import Waitlist from '../components/Waitlist.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_NAME } from '../site';

const intro = `${SITE_NAME} is an essay competition for students aged 20 and under, built around the UN Sustainable Development Goals.`;
---

<Base description={intro}>
  <Hero padBottom={[130, 150]}>
    <h1 class="t-display-xl home-title">Big problems. Young writers. One goal at a time.</h1>
    <p slot="aside" class="t-lead">{intro}</p>
  </Hero>

  <main id="main">
    <div class="intro-row">
      <section class="who">
        <span class="who__dot" aria-hidden="true"></span>
        <h2 class="t-heading">Who we are</h2>
        <p class="t-body-lg who__text">
          We're student volunteers who think young people should have a say on the world's biggest problems, and that
          writing about them can do some real good. Each edition takes one goal, asks three questions, and is a
          fundraiser for [Soup Kitchen Name].
        </p>
        <a class="btn btn--plum" href="/about/">About us</a>
      </section>

      <section class="sdgs">
        <span class="rings sdgs__rings" aria-hidden="true"></span>
        <h2 class="sdgs__title">Built on the Sustainable Development Goals</h2>
        <p class="sdgs__text">
          In 2015, every UN member state agreed to 17 goals to reach by 2030. We focus on the ones about fairness:
          poverty, hunger, education, gender equality, inequality, and justice.
        </p>
        <h3 class="sdgs__label">Goals we focus on</h3>
        <ul class="sdgs__goals">
          <li>Poverty</li>
          <li>Hunger</li>
          <li>Education</li>
          <li>Gender equality</li>
          <li>Inequality</li>
          <li>Justice</li>
        </ul>
      </section>
    </div>

    <section class="why" aria-labelledby="why-title">
      <span class="rings why__rings" aria-hidden="true"></span>
      <p class="t-label why__label">Why Pharos?</p>
      <h2 id="why-title" class="t-display why__title">A light for strangers.</h2>
      <div class="why__img">
        <span class="rings why__rings-d" aria-hidden="true"></span>
        <img
          src="/images/pharos-hero-ship.png"
          width="576"
          height="640"
          alt="Pixel mosaic of a white lighthouse at dusk, its lamp casting a beam across a blue sea to a small sailing boat."
        />
      </div>
      <p class="why__text">
        The Pharos was the lighthouse of Alexandria: one of the Seven Wonders, guiding ships safely in beside the
        greatest library of the ancient world. It was built stone by stone. So is a fairer world, and every essay is
        one more stone.
      </p>
    </section>

    <section class="doings" aria-labelledby="doings-title">
      <h2 id="doings-title" class="t-heading">What we do</h2>
      <div class="doings__grid">
        <div class="doing doing--comp">
          <h3 class="t-heading-sm">The competition</h3>
          <p>One SDG per edition, judged anonymously by humans.</p>
          <a class="btn btn--coral" href="/competition/">See the competition</a>
        </div>
        <div class="doing doing--blog">
          <h3 class="t-heading-sm">The blog</h3>
          <p>Essays and explainers on the SDGs.</p>
          <a class="btn btn--plum" href="/blog/">Read the blog</a>
        </div>
        {/* PLACEHOLDER: goes live once [Soup Kitchen Name] agrees to be named. */}
        <div class="placeholder-card doing--volunteer">
          <span class="pill">Placeholder</span>
          <h3 class="t-heading-sm">Volunteering</h3>
          <p>Volunteering with [Soup Kitchen Name].</p>
          <p class="t-muted">Goes live once [Soup Kitchen Name] agrees to be named.</p>
        </div>
      </div>
    </section>

    <section class="edition" aria-labelledby="edition-title">
      <span class="rings edition__rings-a" aria-hidden="true"></span>
      <span class="rings edition__rings-b" aria-hidden="true"></span>
      <p class="t-label edition__label mobile-only">Inaugural edition: Goal 2, Zero Hunger</p>
      <div class="edition__cover"><EditionCover size={[308, 516]} /></div>
      <div class="edition__text">
        <p class="t-label edition__label desktop-only">Inaugural edition: Goal 2, Zero Hunger</p>
        <h2 id="edition-title" class="t-display">Your essay can feed someone.</h2>
        <p class="edition__line">This edition is a fundraiser for [Soup Kitchen Name]. Opens [month].</p>
        <a class="btn btn--cream desktop-only" href="/competition/">See the competition</a>
      </div>
    </section>

    <div class="closing">
      <div class="closing__arch">
        <Waitlist id="home-waitlist">
          <a class="btn btn--cream mobile-only" href="/competition/">See the competition</a>
        </Waitlist>
      </div>
      <SiteFooter variant="column" />
    </div>
  </main>
</Base>

<style>
  .home-title { margin-top: 64px; max-width: 290px; }

  /* Who we are + SDG panel */
  .who {
    position: relative;
    padding: 44px var(--gutter) 48px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .who > :not(.who__dot) { position: relative; }
  .who__dot {
    position: absolute;
    right: -70px; top: 30px;
    width: 140px; height: 140px;
    border-radius: 50%;
    background: var(--c-pink);
  }
  .who__text { max-width: 300px; }

  .sdgs {
    position: relative;
    margin-left: var(--gutter);
    background: var(--c-slate);
    color: var(--c-cream);
    border-radius: 170px 0 0 0;
    padding: 70px 24px 36px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: hidden;
  }
  .sdgs > :not(.rings) { position: relative; }
  .sdgs__rings { --ring: var(--c-peach); width: 300px; height: 300px; left: 210px; top: -190px; }
  .sdgs__title { font-family: var(--font-display); font-weight: 400; font-size: 32px; line-height: 1.05; }
  .sdgs__text { font-size: 17px; line-height: 1.5; text-wrap: pretty; }
  .sdgs__label { font-size: 16px; font-weight: 400; color: var(--c-peach); margin-top: 8px; }
  .sdgs__goals {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 18px;
    font-family: var(--font-display);
    font-size: 25px;
    line-height: 1.15;
  }

  /* Why Pharos? */
  .why {
    position: relative;
    padding: 56px 15px 8px;
    display: grid;
    gap: 16px;
    overflow: hidden;
  }
  .why > * { position: relative; }
  .why > .why__rings { position: absolute; --ring: var(--c-sea); width: 260px; height: 260px; right: -150px; top: -40px; opacity: 0.5; }
  .why__label, .why__title, .why__text { padding: 0 7px; }
  .why__img img { display: block; width: 100%; image-rendering: pixelated; }
  .why__rings-d { display: none; }
  .why__text { font-size: 17px; line-height: 1.5; text-wrap: pretty; }

  /* What we do */
  .doings { padding: 48px var(--gutter) 52px; display: flex; flex-direction: column; gap: 20px; }
  .doings__grid { display: flex; flex-direction: column; gap: 16px; }
  .doing { display: flex; flex-direction: column; gap: 8px; }
  .doing .btn { margin-top: 6px; }
  .doing--comp {
    margin-left: calc(-1 * var(--gutter));
    background: var(--c-plum);
    color: var(--c-cream);
    border-radius: 0 120px 120px 0;
    padding: 24px 90px 24px var(--gutter);
  }
  .doing--blog {
    margin-right: calc(-1 * var(--gutter));
    background: var(--c-pink);
    color: var(--c-plum-deep);
    border-radius: 120px 0 0 120px;
    padding: 24px var(--gutter) 24px 56px;
  }

  /* Current edition */
  .edition {
    position: relative;
    background: var(--c-plum);
    color: var(--c-cream);
    padding: 36px var(--gutter) 44px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    overflow: hidden;
  }
  .edition > :not(.rings) { position: relative; }
  .edition__rings-a { --ring: var(--c-peach); width: 260px; height: 260px; left: -130px; top: 200px; opacity: 0.7; }
  .edition__rings-b { --ring: var(--c-pink); width: 240px; height: 240px; right: -120px; top: 90px; opacity: 0.8; }
  .edition__label { align-self: stretch; color: var(--c-peach); }
  .edition__cover { display: flex; justify-content: center; width: 100%; }
  .edition__text { align-self: stretch; display: flex; flex-direction: column; gap: 10px; }
  .edition__line { font-size: 17px; line-height: 1.45; }

  /* Waitlist + footer */
  .closing__arch { margin-top: 24px; }

  @media (min-width: 960px) {
    .home-title { margin-top: 110px; max-width: 820px; }

    .intro-row { display: grid; grid-template-columns: minmax(0, 1fr) 52.8%; margin-top: 72px; }
    .who { padding: 40px var(--gutter) 60px; gap: 18px; overflow: visible; }
    .who__dot { left: -130px; right: auto; top: -70px; width: 160px; height: 160px; }
    .who__text { max-width: 520px; }

    .sdgs { margin-left: 0; border-radius: clamp(200px, 20.8vw, 300px) 0 0 0; padding: 110px 64px 64px clamp(80px, 8.3vw, 120px); gap: 18px; }
    .sdgs__rings { --s: clamp(260px, 29.2vw, 420px); width: var(--s); height: var(--s); left: auto; right: calc(var(--s) * -0.55); top: calc(var(--s) * -0.55); }
    .sdgs__title { font-size: clamp(36px, 3.2vw, 46px); line-height: 1.02; max-width: 460px; }
    .sdgs__text { font-size: 19px; }
    .sdgs__label { font-size: 17px; margin-top: 10px; }
    .sdgs__goals { font-size: clamp(28px, 2.36vw, 34px); }

    .why {
      padding: 120px var(--gutter) 0;
      grid-template-columns: 40% minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto 1fr;
      grid-template-areas: 'img .' 'img label' 'img title' 'img text' 'img .';
      column-gap: 6.7%;
      row-gap: 22px;
      overflow: visible;
    }
    .why > .why__rings { display: none; }
    .why__img { grid-area: img; }
    .why__rings-d { display: block; --ring: var(--c-sea); width: 440px; height: 440px; left: -220px; bottom: -150px; opacity: 0.5; }
    .why__img img { position: relative; }
    .why__label { grid-area: label; padding: 0; }
    .why__title { grid-area: title; padding: 0; max-width: 600px; }
    .why__text { grid-area: text; padding: 0; max-width: 600px; font-size: 22px; }

    .doings { padding: 96px var(--gutter); gap: 28px; }
    .doings__grid { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: 20px; align-items: stretch; }
    .doing { gap: 10px; font-size: 18px; }
    .doing .btn { margin-top: auto; }
    .doing p:last-of-type { margin-bottom: 12px; }
    .doing--comp { margin-left: 0; border-radius: 0 180px 180px 0; padding: 36px clamp(80px, 8.3vw, 120px) 36px 36px; }
    .doing--blog { margin-right: 0; border-radius: 180px 0 0 180px; padding: 36px 36px 36px clamp(80px, 7.6vw, 110px); }
    .doing--volunteer p { font-size: 18px; }

    .edition { flex-direction: row; padding: 80px var(--gutter) 88px; gap: clamp(48px, 6.25vw, 90px); }
    .edition__rings-a { width: 420px; height: 420px; left: -200px; top: 260px; }
    .edition__rings-b { width: 360px; height: 360px; right: -150px; top: -150px; }
    .edition__cover { width: auto; margin-left: clamp(0px, 6.25vw, 90px); }
    .edition__text { align-self: center; max-width: 560px; gap: 18px; }
    .edition__line { font-size: 22px; }
    .edition__text .btn { margin-top: 8px; }

    .closing { display: flex; align-items: flex-end; gap: var(--gutter); padding: 64px var(--gutter) 0; }
    .closing__arch { margin-top: 0; width: 57%; flex: none; }
    .closing :global(.footer) { flex: 1; min-width: 0; }
  }
</style>
