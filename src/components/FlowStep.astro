---
// One screen of the Register flow. On mobile it reads top to bottom on the
// peach page: back link and step count, progress bar, title, then the content
// and the button. On desktop the summary (wordmark, count, progress, title)
// becomes the plum slab on the left and the content sits on the right.
import { SITE_NAME } from '../site';

interface Props {
  /** Which step this is, 1 to 4. */
  n: number;
  id: string;
  title: string;
  lead?: string;
  /** Shown beside the title on mobile and under it in the slab on desktop (the entry fee). */
  amount?: string;
  backHref: string;
  /** "← Competition" on step 1, "← Back" elsewhere. */
  backLabel: string;
  /** Longer label for the desktop copy of the back link. */
  backLabelDesktop?: string;
  /** "age" or "ticks": what the script checks before moving on. */
  requires?: string;
}

const { n, id, title, lead, amount, backHref, backLabel, backLabelDesktop = backLabel, requires } = Astro.props;
const goes = backHref.startsWith('#') ? '' : undefined;
---

<section class="fstep" id={`step-${id}`} aria-labelledby={`title-${id}`} data-step data-requires={requires}>
  <div class="fstep__summary">
    <span class="rings fstep__rings desktop-only" aria-hidden="true"></span>
    <a class="fstep__wordmark desktop-only" href="/" aria-label={`${SITE_NAME}, home`}>{SITE_NAME}</a>
    <div class="fstep__bar">
      <a class="fstep__back mobile-only" href={backHref} data-go={goes}>{backLabel}</a>
      <p class="fstep__count">Step {n} of 4</p>
    </div>
    <div class="fprog" aria-hidden="true">
      {[1, 2, 3, 4].map((i) => <span class:list={['fprog__seg', { 'is-on': i <= n }]} />)}
    </div>
    <div class="fstep__titlerow">
      <h2 id={`title-${id}`} class="fstep__title" tabindex="-1">{title}</h2>
      {amount && <p class="fstep__amount">{amount}</p>}
    </div>
    {lead && <p class="fstep__lead">{lead}</p>}
  </div>

  <div class="fstep__main">
    <a class="fstep__back desktop-only" href={backHref} data-go={goes}>{backLabelDesktop}</a>
    <slot />
    <p class="fstep__error" role="alert" data-error hidden></p>
    <div class="fstep__cta"><slot name="cta" /></div>
  </div>
</section>

<style>
  .fstep { display: flex; flex-direction: column; }
  .fstep__summary { position: relative; display: flex; flex-direction: column; padding: 0 var(--gutter); }
  .fstep__bar { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); min-height: 56px; }
  .fstep__back { font-weight: 600; padding: var(--space-1) 0; }
  .fstep__count { margin-left: auto; font-weight: 600; }

  .fprog { display: flex; gap: 6px; padding-top: 2px; }
  .fprog__seg { flex: 1; height: 8px; border-radius: 4px; border: 2px solid currentColor; }
  .fprog__seg.is-on { background: currentColor; }

  .fstep__titlerow { padding-top: var(--space-3); display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-2); }
  .fstep__title, .fstep__amount { font-family: var(--font-display); font-weight: 400; font-size: var(--fs-heading); line-height: var(--lh-display); }
  .fstep__title:focus-visible { outline-offset: 6px; }
  .fstep__lead { padding-top: 6px; font-size: var(--fs-body); line-height: var(--lh-body); }

  .fstep__main { padding: var(--space-3) var(--gutter) 0; display: flex; flex-direction: column; gap: var(--space-2); flex: 1; }
  .fstep__main :global(:focus-visible) { outline-color: var(--c-plum); }
  .fstep__error {
    background: var(--c-pink);
    color: var(--c-plum-deep);
    border-radius: var(--radius-card);
    padding: var(--space-1) var(--space-2);
    font-weight: 600;
  }
  .fstep__error[hidden] { display: none; }
  .fstep__cta { margin-top: auto; padding: var(--space-2) 0 var(--space-3); display: flex; flex-direction: column; gap: var(--space-2); }
  .fstep__cta > :global(*) { display: flex; flex-direction: column; gap: var(--space-2); }
  .fstep__cta :global(.btn) { align-self: stretch; justify-content: center; min-height: 56px; font-size: var(--fs-body-lg); }
  .fstep__rings { --ring: var(--c-pink); }

  @media (min-width: 960px) {
    .fstep { display: grid; grid-template-columns: clamp(480px, 41.67%, 760px) minmax(0, 1fr); align-items: start; }
    .fstep__summary {
      background: var(--c-plum);
      color: var(--c-cream);
      border-radius: 0 0 clamp(190px, 20.8vw, 340px) 0;
      padding: var(--space-4) var(--gutter) calc(var(--space-12) + var(--space-3));
      gap: var(--space-3);
      overflow: hidden;
    }
    .fstep__summary > :not(.rings) { position: relative; }
    .fstep__summary :global(:focus-visible) { outline-color: var(--c-cream); }
    .fstep__rings { --ring-gap: 11px; --s: clamp(300px, 29vw, 420px); width: var(--s); height: var(--s); right: calc(var(--s) * -0.38); bottom: calc(var(--s) * -0.38); }
    .fstep__wordmark { font-family: var(--font-script); font-size: var(--fs-wordmark); line-height: var(--lh-wordmark); color: var(--c-peach); text-decoration: none; align-self: flex-start; }
    .fstep__bar { margin-top: var(--space-6); min-height: 0; }
    .fstep__count { margin-left: 0; font-size: var(--fs-lead); }
    .fprog { width: 300px; }
    .fstep__titlerow { flex-direction: column; align-items: flex-start; padding-top: var(--space-1); gap: var(--space-1); }
    .fstep__title { font-size: var(--fs-display); line-height: 1; }
    .fstep__amount { font-size: var(--fs-heading); color: var(--c-peach); }
    .fstep__lead { font-size: var(--fs-lead); line-height: var(--lh-lead); max-width: 45%; }

    .fstep__main { padding: var(--space-12) var(--space-12) var(--space-6) var(--space-6); gap: var(--space-3); max-width: 760px; width: 100%; }
    .fstep__back { font-size: var(--fs-body-lg); align-self: flex-start; }
    .fstep__cta { padding: var(--space-1) 0 0; margin-top: var(--space-1); }
    .fstep__cta > :global(*) { display: flex; flex-direction: column; gap: var(--space-2); }
  .fstep__cta :global(.btn) { min-height: 60px; }
  }
</style>
