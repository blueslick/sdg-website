---
// One FAQ question: a native <details>/<summary> (no scripts), closed by default.
// `id` is a stable anchor (e.g. #fee-support-how) so other pages can deep-link to a question.
// It sits on the answer, not on the <details> or the <summary>: browsers open a closed <details>
// when a link targets something inside its hidden content (with no script), but not when the link
// targets the <details> itself or its always-visible <summary>. scroll-margin keeps the question in view.
interface Props {
  id: string;
  question: string;
}

const { id, question } = Astro.props;
---

<details class="faq-item">
  <summary class="faq-item__q">{question}</summary>
  <div class="faq-item__a" id={id}><slot /></div>
</details>

<style>
  .faq-item { border-top: 1.5px solid var(--c-plum); }
  .faq-item:last-child { border-bottom: 1.5px solid var(--c-plum); }

  /* The whole row is the tap target: at least 56px tall, well over the 44px minimum. */
  .faq-item__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: 56px;
    padding: 10px 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq-item__q::-webkit-details-marker { display: none; }
  /* A plus that becomes a minus when open; drawn with text so it needs no image. The second
     content value (after the slash) is its alternative text, empty so screen readers skip it. */
  .faq-item__q::after {
    content: '+';
    content: '+' / '';
    flex: none;
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
  }
  .faq-item[open] > .faq-item__q::after { content: '−'; content: '−' / ''; }
  .faq-item__q:focus-visible { outline: 3px solid var(--c-plum); outline-offset: -3px; border-radius: 4px; }

  .faq-item__a { scroll-margin-top: 72px; padding: 0 0 var(--space-2); display: flex; flex-direction: column; gap: 10px; max-width: 680px; font-weight: 400; text-wrap: pretty; }
  .faq-item__a :global(a) { font-weight: 600; overflow-wrap: anywhere; }
</style>
