---
import { NAV } from '../site';

interface Props {
  current?: string;
  place: 'slab' | 'aside';
}

const { current, place } = Astro.props;
---

<nav class:list={['nav', `nav--${place}`]} aria-label="Main">
  {NAV.map((item) => (
    <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
  ))}
</nav>

<style>
  .nav { display: flex; flex-wrap: wrap; column-gap: 14px; font-size: 16px; }
  .nav a { text-decoration: none; padding: 12px 0; }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav--slab a[aria-current='page'] { text-decoration-color: var(--c-coral); }
  .nav--aside { flex-wrap: nowrap; justify-content: flex-end; column-gap: clamp(16px, 1.95vw, 28px); font-size: 18px; font-weight: 500; }
  .nav--aside a[aria-current='page'] { text-decoration-color: var(--c-plum); text-underline-offset: 8px; }

  @media (min-width: 960px) {
    .nav--slab { display: none; }
  }
  @media (max-width: 959.98px) {
    .nav--aside { display: none; }
  }
</style>
