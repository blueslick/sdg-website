---
// Who the fundraiser is for: the soup kitchen's logo (used with their written
// permission), "A fundraiser for ..." and links to their socials. Shown where the
// beneficiary is introduced (Competition, About). The logo is not part of the
// Pharos brand: it stays out of the header, footer and wordmark, and is never
// recoloured, cropped, stretched or given effects.
import { SOUP_KITCHEN_NAME, SOUP_KITCHEN_FACEBOOK_URL, SOUP_KITCHEN_INSTAGRAM_URL } from '../site';

const links = [
  { label: 'Facebook', href: SOUP_KITCHEN_FACEBOOK_URL },
  { label: 'Instagram', href: SOUP_KITCHEN_INSTAGRAM_URL },
];
---

<div class="sk">
  <picture class="sk__logo">
    <source srcset="/images/task-logo-600.webp" type="image/webp" />
    <img
      src="/images/task-logo-600.png"
      width="600"
      height="516"
      loading="lazy"
      decoding="async"
      alt="The Assembly Soup Kitchen (T.A.S.K) logo"
    />
  </picture>
  <div class="sk__text">
    <p class="sk__line">A fundraiser for {SOUP_KITCHEN_NAME}</p>
    <ul class="sk__links" aria-label="Their pages">
      {links.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener noreferrer">
            {l.label}<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .sk { display: flex; align-items: center; gap: 18px; }
  /* A plain cream tile behind the logo so it always sits on the same background. */
  .sk__logo { flex: none; display: block; background: var(--c-cream); border-radius: 16px; padding: 10px; }
  .sk__logo img { display: block; width: 104px; height: auto; }
  .sk__text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .sk__line { font-size: 18px; line-height: 1.3; font-weight: 600; overflow-wrap: anywhere; }
  .sk__links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; column-gap: 20px; }
  .sk__links a { display: inline-block; padding: 12px 0; font-size: 16px; font-weight: 600; color: inherit; text-underline-offset: 3px; }

  @media (min-width: 960px) {
    .sk { gap: 28px; }
    .sk__logo img { width: 128px; }
    .sk__line { font-size: 22px; }
    .sk__links a { font-size: 18px; }
  }
</style>
