---
// The closing arch on Home and Competition. Two states, set by REGISTRATION_OPEN in src/site.ts:
//  - false (pre-launch): the waitlist, a Tally form (TallyForm.astro; the form is set in
//    src/site.ts). The consent line and Privacy link stay directly under it.
//  - true: "Entries are open" with a Register button that links to /register/.
import TallyForm from './TallyForm.astro';
import { DATES, formatDate, INSTAGRAM_HANDLE, INSTAGRAM_URL, REGISTRATION_OPEN } from '../site';

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<section class="waitlist" aria-labelledby={`${id}-title`}>
  <span class="rings rings--arch waitlist__rings" aria-hidden="true"></span>
  {
    REGISTRATION_OPEN ? (
      <>
        <h2 id={`${id}-title`} class="waitlist__title">Entries are open</h2>
        <p class="waitlist__small">Deadline {formatDate(DATES.deadline)}. You enter through one short online form.</p>
        <a class="btn btn--coral waitlist__register" href="/register/">Register</a>
      </>
    ) : (
      <>
        <h2 id={`${id}-title`} class="waitlist__title">Get told when entries open</h2>

        <TallyForm />

        <p class="waitlist__small">We will only email you once, when entries open. <a href="/privacy/">Privacy notice</a></p>
      </>
    )
  }
  <p class="waitlist__insta">Or follow along on Instagram <a href={INSTAGRAM_URL}><strong>{INSTAGRAM_HANDLE}</strong></a></p>
  <slot />
</section>

<style>
  .waitlist {
    position: relative;
    background: var(--c-slate);
    color: var(--c-cream);
    border-radius: var(--radius-round) var(--radius-round) 0 0;
    padding: 118px 24px 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-align: center;
  }
  .waitlist__rings {
    --ring: var(--c-peach);
    width: 160px; height: 80px;
    left: 50%; top: 20px;
    transform: translateX(-50%);
    opacity: 0.55;
  }
  .waitlist__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 34px;
    line-height: 1.02;
  }
  .waitlist__small { font-size: 16px; line-height: 1.4; }
  .waitlist__insta { font-size: 17px; line-height: 1.4; margin-top: 4px; }
  .waitlist :global(.btn--cream) { align-self: center; margin-top: 6px; }
  .waitlist__register { align-self: center; justify-content: center; min-width: 200px; font-size: 17px; }

  @media (min-width: 960px) {
    .waitlist { padding: 190px clamp(48px, 7.6vw, 110px) 64px; gap: 18px; }
    .waitlist__rings { width: 260px; height: 130px; top: 34px; }
    .waitlist__title { font-size: 50px; }
    .waitlist__small { font-size: 17px; }
    .waitlist__insta { font-size: 19px; margin-top: 6px; }
  }
</style>
